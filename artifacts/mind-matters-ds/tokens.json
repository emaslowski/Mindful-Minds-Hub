{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "The Brightside Project Design System tokens extracted from The Brightside Project student wellness app. DTCG format. THIS FILE IS THE SINGLE SOURCE OF TRUTH — edit values here only. Colors as hex; build-tokens.mjs converts to H S% L% channels for the web theme. Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background":          { "$value": "#f5efe5", "$description": "Warm cream parchment page background." },
      "foreground":          { "$value": "#453329", "$description": "Dark chocolate default text." },
      "border":              { "$value": "#d5cabe", "$description": "Muted tan default border." },
      "card":                { "$value": "#eee6d8", "$description": "Warm beige card surface." },
      "cardForeground":      { "$value": "#453329" },
      "popover":             { "$value": "#eee6d8" },
      "popoverForeground":   { "$value": "#453329" },
      "primary":             { "$value": "#c4622d", "$description": "Terracotta — primary brand color for CTAs, links, emphasis." },
      "primaryForeground":   { "$value": "#faf3e3", "$description": "Cream white text on terracotta." },
      "secondary":           { "$value": "#688a52", "$description": "Sage green — secondary actions and outlined variants." },
      "secondaryForeground": { "$value": "#faf3e3" },
      "muted":               { "$value": "#c4829a", "$description": "Dusty rose — muted surfaces and soft labels." },
      "mutedForeground":     { "$value": "#453329" },
      "accent":              { "$value": "#d4a44c", "$description": "Warm amber — accent highlights and tertiary actions." },
      "accentForeground":    { "$value": "#453329" },
      "destructive":         { "$value": "#c93b3b", "$description": "Warm red for errors and destructive actions." },
      "destructiveForeground": { "$value": "#faf3e3" },
      "input":               { "$value": "#d5cabe" },
      "ring":                { "$value": "#c4622d" },
      "chart1":              { "$value": "#c4622d" },
      "chart2":              { "$value": "#688a52" },
      "chart3":              { "$value": "#d4a44c" },
      "chart4":              { "$value": "#c4829a" },
      "chart5":              { "$value": "#8b7355" },
      "sidebar":             { "$value": "#eee6d8" },
      "sidebarForeground":   { "$value": "#453329" },
      "sidebarBorder":       { "$value": "#d0c4b5" },
      "sidebarPrimary":      { "$value": "#c4622d" },
      "sidebarPrimaryForeground": { "$value": "#faf3e3" },
      "sidebarAccent":       { "$value": "#d4a44c" },
      "sidebarAccentForeground": { "$value": "#453329" },
      "sidebarRing":         { "$value": "#c4622d" }
    },
    "dark": {
      "background":          { "$value": "#2a1f18", "$description": "Deep chocolate-brown page background." },
      "foreground":          { "$value": "#f5efe5" },
      "border":              { "$value": "#5a4035" },
      "card":                { "$value": "#3a2b22" },
      "cardForeground":      { "$value": "#f5efe5" },
      "popover":             { "$value": "#3a2b22" },
      "popoverForeground":   { "$value": "#f5efe5" },
      "primary":             { "$value": "#d47248", "$description": "Lighter terracotta for dark mode CTAs." },
      "primaryForeground":   { "$value": "#faf3e3" },
      "secondary":           { "$value": "#8aad6e", "$description": "Lighter sage green for dark surfaces." },
      "secondaryForeground": { "$value": "#2a1f18" },
      "muted":               { "$value": "#5a3a4c" },
      "mutedForeground":     { "$value": "#d5c0c8" },
      "accent":              { "$value": "#e8bc6e" },
      "accentForeground":    { "$value": "#2a1f18" },
      "destructive":         { "$value": "#e05050" },
      "destructiveForeground": { "$value": "#faf3e3" },
      "input":               { "$value": "#5a4035" },
      "ring":                { "$value": "#d47248" },
      "chart1":              { "$value": "#d47248" },
      "chart2":              { "$value": "#8aad6e" },
      "chart3":              { "$value": "#e8bc6e" },
      "chart4":              { "$value": "#d498b2" },
      "chart5":              { "$value": "#b8a080" },
      "sidebar":             { "$value": "#2e2018" },
      "sidebarForeground":   { "$value": "#f5efe5" },
      "sidebarBorder":       { "$value": "#4a3228" },
      "sidebarPrimary":      { "$value": "#d47248" },
      "sidebarPrimaryForeground": { "$value": "#faf3e3" },
      "sidebarAccent":       { "$value": "#e8bc6e" },
      "sidebarAccentForeground": { "$value": "#2a1f18" },
      "sidebarRing":         { "$value": "#d47248" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Nunito", "sans-serif"],             "$description": "Body and UI typeface — friendly, rounded humanist sans." },
      "serif": { "$value": ["Cormorant Garamond", "serif"],      "$description": "Display and heading typeface — editorial, italic-forward serif." },
      "mono":  { "$value": ["Caveat", "cursive"],                "$description": "Handwritten accent typeface used for prompts, labels, and quotes (not a monospace face)." }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "1.25rem", "$description": "Base radius (20px) — generous rounding used on cards and controls. sm/md/lg/xl derive from this." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Base spacing step (4px) that components multiply." }
  }
}
