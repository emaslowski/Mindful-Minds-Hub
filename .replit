modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "cloudrun"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "lcms2", "libimagequant", "libjpeg", "libjpeg_turbo", "libtiff", "libwebp", "libxcrypt", "mupdf", "openjpeg", "swig", "tcl", "tk", "xcbuild", "zlib"]

[userenv]

[userenv.shared]
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
ADMIN_EMAILS = "mindmatters0526@gmail.com"
CREDENTIAL_EMAIL_CONNECTION_ID = "conn_google-mail_01M6EBGW80EPE435Q95TEZDK8R"
CREDENTIAL_EMAIL_SENDER = "emaslowski@royhart.org"

[objectStorage]
defaultBucketID = "replit-objstore-599a0bed-107d-495a-9a7e-a9e88b934359"
