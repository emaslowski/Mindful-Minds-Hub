{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"if(!/^pnpm\\//.test(process.env.npm_config_user_agent||'')){console.error('Use pnpm instead');process.exit(1)}\"",
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/mind-matters --filter @workspace/studio run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:app": "pnpm --filter @workspace/api-server --filter @workspace/mind-matters --filter @workspace/studio run build",
    "dev:kits": "pnpm --filter @workspace/brightside-kits run dev",
    "build:kits": "pnpm --filter @workspace/brightside-kits run build",
    "start": "node --enable-source-maps --env-file-if-exists=.env artifacts/api-server/dist/index.mjs",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:migrate": "node lib/db/scripts/apply-migrations.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
