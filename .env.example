# Copy this file to .env and fill in the values. Never commit .env.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
# Public address of the site, no trailing slash. Used to build the Google
# sign-in callback URL: <APP_URL>/api/auth/google/callback
APP_URL=http://localhost:5173

# ─── Database (PostgreSQL 16) ─────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/brightside

# ─── Google sign-in (Google Cloud Console → APIs & Services → Credentials) ────
# OAuth client type "Web application"; authorized redirect URI:
#   <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Teachers (comma-separated). These accounts get the teacher role.
ADMIN_EMAILS=mindmatters0526@gmail.com
# Optional Studio username/password login for the admin account.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── File storage (Google Cloud Storage) ──────────────────────────────────────
# Paste the whole service-account JSON key on one line, OR leave empty and set
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json instead.
GCS_SERVICE_ACCOUNT_KEY=
# /<bucket>/<folder> paths inside your bucket.
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket/public
PRIVATE_OBJECT_DIR=/your-bucket/.private

# ─── Notification email (SMTP) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Student credential email (Gmail API, school mailbox only) ────────────────
CREDENTIAL_EMAIL_SENDER=emaslowski@royhart.org
# Refresh token for the sender mailbox with gmail.send + gmail.readonly scopes.
GMAIL_REFRESH_TOKEN=
# Optional; default to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
